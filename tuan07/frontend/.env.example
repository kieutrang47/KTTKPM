# Frontend Environment Variables
# Copy this file to .env and update with your actual values

# === LOCAL DEPLOYMENT (1 máy) ===
VITE_USER_API_URL=http://localhost:8081/users
VITE_CATALOG_API_URL=http://localhost:8082/menu
VITE_ORDER_API_URL=http://localhost:8083/orders
VITE_PAYMENT_API_URL=http://localhost:8084/payments

# === MULTI-MACHINE DEPLOYMENT ===
# Uncomment và thay đổi IP theo máy thực tế
# VITE_USER_API_URL=http://192.168.1.10:8081/users
# VITE_CATALOG_API_URL=http://192.168.1.11:8082/menu
# VITE_ORDER_API_URL=http://192.168.1.12:8083/orders
# VITE_PAYMENT_API_URL=http://192.168.1.13:8084/payments
